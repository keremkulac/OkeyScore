<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.saveSingleGame.SaveSingleGameFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/single_game" />

    <androidx.cardview.widget.CardView
        android:id="@+id/playerNameEntryCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_large"
        android:outlineSpotShadowColor="@color/cardview_shadow_color"
        android:visibility="visible"
        app:cardBackgroundColor="@color/cardview_background_color"
        app:cardCornerRadius="@dimen/card_radius_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        tools:targetApi="28">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/player1NameEntryHint"
                style="@style/SingleGameTextInputLayoutStyle"
                android:hint="@string/enter_player1_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/player1NameEntry"
                    style="@style/SingleGameTextInputEditTextStyle"
                    android:inputType="text"
                    android:maxLength="21" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/player2NameEntryHint"
                style="@style/SingleGameTextInputLayoutStyle"
                android:hint="@string/enter_player2_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/player1NameEntryHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/player2NameEntry"
                    style="@style/SingleGameTextInputEditTextStyle"
                    android:inputType="text"
                    android:maxLength="21" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/player3NameEntryHint"
                style="@style/SingleGameTextInputLayoutStyle"
                android:hint="@string/enter_player3_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/player2NameEntryHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/player3NameEntry"
                    style="@style/SingleGameTextInputEditTextStyle"
                    android:inputType="text"
                    android:maxLength="21" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/player4NameEntryHint"
                style="@style/SingleGameTextInputLayoutStyle"
                android:hint="@string/enter_player4_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/player3NameEntryHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/player4NameEntry"
                    style="@style/SingleGameTextInputEditTextStyle"
                    android:inputType="text"
                    android:maxLength="21" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmNames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_names"
                android:textAllCaps="false"
                android:visibility="visible"
                app:cornerRadius="@dimen/card_radius_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/player4NameEntryHint" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/playerTotalScoreCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginEnd="@dimen/margin_large"
        android:outlineSpotShadowColor="@color/cardview_shadow_color"
        android:visibility="gone"
        app:cardBackgroundColor="@color/cardview_background_color"
        app:cardCornerRadius="@dimen/card_radius_large"
        app:cardElevation="@dimen/card_elevation_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:targetApi="28">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/padding_large"
            android:paddingBottom="@dimen/padding_large">

            <TextView
                android:id="@+id/playerScoresTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_scores_title"
                android:textSize="@dimen/text_size_xlarge"
                android:textStyle="bold"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/player1Layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/player2Layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/playerScoresTitle"
                tools:layout_editor_absoluteY="84dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_player" />

                <TextView
                    android:id="@+id/totalScorePlayer1Name"
                    style="@style/TotalScoreCardViewNameStyle"
                    tools:text="Player 1" />

                <TextView
                    android:id="@+id/player1TotalScore"
                    style="@style/TotalScoreCardViewTotalScoreStyle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player2Layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/player3Layout"
                app:layout_constraintStart_toEndOf="@+id/player1Layout"
                app:layout_constraintTop_toTopOf="@+id/player1Layout">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_player" />

                <TextView
                    android:id="@+id/totalScorePlayer2Name"
                    style="@style/TotalScoreCardViewNameStyle"
                    tools:text="Player 2" />

                <TextView
                    android:id="@+id/player2TotalScore"
                    style="@style/TotalScoreCardViewTotalScoreStyle" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/player3Layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/player4Layout"
                app:layout_constraintStart_toEndOf="@+id/player2Layout"
                app:layout_constraintTop_toTopOf="@+id/player1Layout">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_player" />

                <TextView
                    android:id="@+id/totalScorePlayer3Name"
                    style="@style/TotalScoreCardViewNameStyle"
                    tools:text="Player 3" />

                <TextView
                    android:id="@+id/player3TotalScore"
                    style="@style/TotalScoreCardViewTotalScoreStyle" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/player4Layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/player3Layout"
                app:layout_constraintTop_toTopOf="@+id/player1Layout">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_player" />

                <TextView
                    android:id="@+id/totalScorePlayer4Name"
                    style="@style/TotalScoreCardViewNameStyle"
                    tools:text="Player 4" />

                <TextView
                    android:id="@+id/player4TotalScore"
                    style="@style/TotalScoreCardViewTotalScoreStyle" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_small"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playerTotalScoreCardView">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_small">

            <TextView
                android:id="@+id/scoreEntryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:text="@string/score_entry_title"
                android:textSize="@dimen/text_size_xlarge"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/scoreLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scoreEntryTitle" />

            <androidx.cardview.widget.CardView
                android:id="@+id/newRound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin_large"
                android:outlineSpotShadowColor="@color/cardview_shadow_color"
                app:cardBackgroundColor="#4FC3F7"
                app:cardCornerRadius="@dimen/card_radius_large"
                app:cardElevation="@dimen/card_elevation_medium"
                app:layout_constraintEnd_toStartOf="@+id/penalty"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scoreLayout"
                tools:targetApi="28">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_small">

                    <ImageView
                        android:id="@+id/newRoundIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/header_icon_style"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_add"
                        app:tint="#FFFFFF"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_large"
                        android:text="@string/new_round"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:layout_constraintBottom_toBottomOf="@+id/newRoundIcon"
                        app:layout_constraintStart_toEndOf="@+id/newRoundIcon"
                        app:layout_constraintTop_toTopOf="@+id/newRoundIcon" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/penalty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_large"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin_small"
                android:outlineSpotShadowColor="@color/cardview_shadow_color"
                app:cardBackgroundColor="#EF9A9A"
                app:cardCornerRadius="@dimen/card_radius_large"
                app:cardElevation="@dimen/card_elevation_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/newRound"
                app:layout_constraintTop_toBottomOf="@+id/scoreLayout"
                tools:targetApi="28">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_small">

                    <ImageView
                        android:id="@+id/penaltyIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/header_icon_style"
                        android:contentDescription="@string/todo"
                        android:padding="3dp"
                        app:tint="#FFFFFF"
                        android:src="@drawable/ic_penalty"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_large"
                        android:text="@string/penalty"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:layout_constraintBottom_toBottomOf="@+id/penaltyIcon"
                        app:layout_constraintStart_toEndOf="@+id/penaltyIcon"
                        app:layout_constraintTop_toTopOf="@+id/penaltyIcon" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/saveScores"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginEnd="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_small"
                android:outlineSpotShadowColor="@color/cardview_shadow_color"
                app:cardBackgroundColor="#80CBC4"
                app:cardCornerRadius="@dimen/card_radius_large"
                app:cardElevation="@dimen/card_elevation_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/newRound"
                tools:targetApi="28">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_small">

                    <ImageView
                        android:id="@+id/saveScoresIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/header_icon_style"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_check"
                        app:layout_constraintEnd_toStartOf="@+id/saveScoresText"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#ffffff" />

                    <TextView
                        android:id="@+id/saveScoresText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_large"
                        android:text="@string/save"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:layout_constraintBottom_toBottomOf="@+id/saveScoresIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/saveScoresIcon"
                        app:layout_constraintTop_toTopOf="@+id/saveScoresIcon" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>